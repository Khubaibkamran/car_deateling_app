# Copy to .env. Real phone: your PC's LAN address; emulator default is http://10.0.2.2:8000/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
# Firebase console > Authentication > Sign-in method > Google > Web SDK configuration > Web client ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Google Cloud console > APIs & Services > enable "Maps SDK for Android", then create an API key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
